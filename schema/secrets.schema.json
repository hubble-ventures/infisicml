{
  "$id": "https://github.com/hubble-ventures/infisicml/schema/secrets.schema.json",
  "title": "infisicml secrets manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        },
        "fetch": {
          "type": "string",
          "enum": [
            "folder",
            "keys"
          ]
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\/(?:[^/\\s]+(?:\\/[^/\\s]+)*)?$"
          },
          "keys": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              ]
            }
          }
        },
        "required": [
          "path",
          "keys"
        ],
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "secrets": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\/(?:[^/\\s]+(?:\\/[^/\\s]+)*)?$"
                },
                "keys": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                        }
                      }
                    ]
                  }
                }
              },
              "required": [
                "path",
                "keys"
              ],
              "additionalProperties": false
            }
          },
          "fetch": {
            "type": "string",
            "enum": [
              "folder",
              "keys"
            ]
          }
        },
        "required": [
          "secrets"
        ],
        "additionalProperties": false
      }
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "optional": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "project",
    "secrets"
  ],
  "additionalProperties": false
}
